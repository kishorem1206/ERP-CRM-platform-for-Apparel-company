# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=false

# ── Seed / Admin bootstrap ────────────────────────────────────────────────────
# Set before running: python -m app.db.seed  (and for integration tests)
ADMIN_SEED_PASSWORD=change-me-strong-password

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apparel_erp
DATABASE_URL=postgresql+asyncpg://erp_user:change-me@postgres:5432/apparel_erp
# For local dev (outside Docker): DATABASE_URL=postgresql+asyncpg://erp_user:change-me@localhost:5433/apparel_erp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_PATH=/media
# AWS S3 (only needed when STORAGE_BACKEND=s3):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                  # Leave blank to disable Sentry

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_URL=http://backend:8000
